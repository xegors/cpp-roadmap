# Минимальный общий стиль для репозитория: база LLVM + отступ 4 пробела,
# как в большинстве существующих файлов. Существующие файлы под этот
# конфиг не переформатированы специально — правится только новый код,
# при правках старого подстраивайся под стиль конкретного файла.
BasedOnStyle: LLVM
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 100
BreakBeforeBraces: Attach
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
PointerAlignment: Left
ReferenceAlignment: Left
